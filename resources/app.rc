#pragma code_page(65001)

#include "resource.h"
#include <windows.h>

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

IDI_TABLER_POINTER ICON "tabler\\generated\\pointer.ico"
IDI_TABLER_RECTANGLE ICON "tabler\\generated\\rectangle.ico"
IDI_TABLER_LINE ICON "tabler\\generated\\line.ico"
IDI_TABLER_OVAL ICON "tabler\\generated\\oval.ico"
IDI_TABLER_ARROW_UP_RIGHT ICON "tabler\\generated\\arrow-up-right.ico"
IDI_TABLER_HIGHLIGHT ICON "tabler\\generated\\highlight.ico"
IDI_TABLER_LETTER_T ICON "tabler\\generated\\letter-t.ico"
IDI_TABLER_BLUR ICON "tabler\\generated\\blur.ico"
IDI_TABLER_CROP ICON "tabler\\generated\\crop.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,23,0
 PRODUCTVERSION 0,1,23,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041904b0"
        BEGIN
            VALUE "CompanyName", "Screenshooter"
            VALUE "FileDescription", "Локальный редактор снимков экрана"
            VALUE "FileVersion", "0.1.23"
            VALUE "InternalName", "screenshooter"
            VALUE "OriginalFilename", "screenshooter.exe"
            VALUE "ProductName", "Screenshooter"
            VALUE "ProductVersion", "0.1.23"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x419, 1200
    END
END

STRINGTABLE
BEGIN
    IDS_APP_TITLE "Screenshooter"
    IDS_WINDOW_CLASS "Screenshooter.MainWindow"
END
