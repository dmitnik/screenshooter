#pragma code_page(65001)

#include "resource.h"
#include <windows.h>

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,11,0
 PRODUCTVERSION 0,1,11,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041904b0"
        BEGIN
            VALUE "CompanyName", "Screenshooter"
            VALUE "FileDescription", "Локальный редактор снимков экрана"
            VALUE "FileVersion", "0.1.11"
            VALUE "InternalName", "screenshooter"
            VALUE "OriginalFilename", "screenshooter.exe"
            VALUE "ProductName", "Screenshooter"
            VALUE "ProductVersion", "0.1.11"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x419, 1200
    END
END

STRINGTABLE
BEGIN
    IDS_APP_TITLE "Screenshooter"
    IDS_WINDOW_CLASS "Screenshooter.MainWindow"
END
